// Prisma Schema — Trading Game Platform
// All 11 tables (TakeRequest dropped in phase-1 migration)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled URL at runtime (e.g. DO connection pool + ?pgbouncer=true)
  url       = env("TRADING_DATABASE_URL")
  // Direct Postgres for migrations / introspection (bypasses PgBouncer)
  directUrl = env("TRADING_DATABASE_DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  LIQUIDITY_PROVIDER
  USER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ContractStatus {
  OPEN
  SETTLED
}

enum QuoteStatus {
  OPEN
  EXHAUSTED
  CANCELLED
}

enum Side {
  OVER
  UNDER
}

enum TradeStatus {
  OPEN
  SETTLED
}

enum EventType {
  INITIAL_SEED
  SETTLEMENT
  ADMIN_ADJUSTMENT
}

// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique
  email          String     @unique
  hashedPassword String
  balance        Int        @default(0)
  role           Role       @default(USER)
  status         UserStatus @default(PENDING)
  approvedAt     DateTime?
  approvedBy     Int?
  // Discord account link (Phase 2). discordId is the Discord user snowflake;
  // @unique so one Discord account maps to at most one trading user.
  discordId       String?   @unique
  discordUsername String?
  discordLinkedAt DateTime?
  // Sandbox account minted by "Enter as demo trader" on the public deployment.
  // Flagged in its own column rather than inferred from the username, so the
  // guardrails (no API keys, recycling cap) key off one boolean.
  isDemo         Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  quotes              Quote[]
  createdContracts     Contract[]           @relation("CreatedContracts")
  tradesAsTaker        Trade[]              @relation("TakerTrades")
  tradesAsMaker        Trade[]              @relation("MakerTrades")
  hints                Hint[]
  notifications        Notification[]
  balanceLedger        BalanceLedger[]
  passwordResetTokens  PasswordResetToken[]
  apiKeys              ApiKey[]
  messages             Message[]            @relation("SentMessages")
  receivedMessages     Message[]            @relation("ReceivedMessages")

  @@index([status])
  @@index([isDemo, createdAt])
}

// Bot/programmatic-access credential. A user mints an ApiKey, gets the full
// secret ONCE (`tgk_<random>`), and a bot then authenticates with it via
// `Authorization: Bearer tgk_...` against the /api/v1 namespace.
//
// Only the SHA-256 hash of the secret is stored — the plaintext is never
// persisted. `keyPrefix` (first ~12 chars of the full key) is shown in the UI
// to identify a key and is the O(1) lookup handle on each request.
model ApiKey {
  id           Int       @id @default(autoincrement())
  userId       Int
  label        String
  keyPrefix    String    @unique
  hashedSecret String
  scopes       String[]
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Contract {
  id              Int            @id @default(autoincrement())
  title           String
  description     String
  status          ContractStatus @default(OPEN)
  minPrice        Int            @default(0)
  maxPrice        Int            @default(100)
  settlementValue Int?
  // When this market is scheduled to settle, and when it actually did. A real
  // exchange always shows the first; without it every market reads as open
  // ended. The second is set by the settle route, so "settled 3 days ago" does
  // not have to be inferred from updatedAt.
  settlesAt       DateTime?
  settledAt       DateTime?
  // The creator's committed result, entered and locked at creation so they
  // cannot pick an outcome after seeing positions. Required for player-created
  // markets; nullable for admin/legacy markets. Never returned by default —
  // globally omitted in lib/prisma.ts; creator-facing paths opt back in.
  lockedResult    Int?
  // The user who created this market. They are its primary market maker and
  // may settle it (alongside any admin). Null for legacy/admin-seeded markets.
  createdById     Int?
  // Row came from scripts/seed-demo.mjs. Seed provenance belongs in a column,
  // not in `description` — a marker appended to that text renders verbatim in
  // the market header for every visitor.
  isDemoSeed      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  creator     User?        @relation("CreatedContracts", fields: [createdById], references: [id])
  quotes      Quote[]
  trades      Trade[]
  hints       Hint[]
  pricePoints PricePoint[]
  messages    Message[]

  @@index([createdById])
}

// In-app chat. Routing:
//   - contractId set, recipientId null → that market's chat
//   - contractId null, recipientId null → global lobby
//   - contractId null, recipientId set → direct message (1-1) between
//     userId (sender) and recipientId
model Message {
  id          Int      @id @default(autoincrement())
  contractId  Int?
  userId      Int
  recipientId Int?
  body        String
  createdAt   DateTime @default(now())

  user      User      @relation("SentMessages", fields: [userId], references: [id])
  recipient User?     @relation("ReceivedMessages", fields: [recipientId], references: [id])
  contract  Contract? @relation(fields: [contractId], references: [id])

  @@index([contractId, createdAt])
  @@index([recipientId])
}

// Time series of the market mid-price per contract — powers the live price chart.
// One row is appended whenever the market mid moves (after a fill or a quote change).
model PricePoint {
  id         Int      @id @default(autoincrement())
  contractId Int
  ts         DateTime @default(now())
  mid        Float
  lastTrade  Int?
  bestBid    Int?
  bestAsk    Int?

  contract Contract @relation(fields: [contractId], references: [id])

  @@index([contractId, ts])
}

model Quote {
  id         Int         @id @default(autoincrement())
  contractId Int
  makerId    Int
  bid        Int?
  ask        Int?
  // Per-side inventory. A side is "live" iff its price is non-null AND its
  // size > 0. Hitting the ask only decrements askSize; the bid is untouched.
  bidSize    Int?
  askSize    Int?
  status     QuoteStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relations
  contract Contract @relation(fields: [contractId], references: [id])
  maker    User     @relation(fields: [makerId], references: [id])
  trades   Trade[]

  @@index([contractId])
  @@index([makerId])
  @@index([contractId, status])
}

model Trade {
  id             Int         @id @default(autoincrement())
  contractId     Int
  quoteId        Int
  takerId        Int
  makerId        Int
  takerSide      Side
  strike         Int
  size           Int
  status         TradeStatus @default(OPEN)
  takerPnl       Int?
  makerPnl       Int?
  idempotencyKey String?
  createdAt      DateTime    @default(now())

  // Relations
  contract Contract @relation(fields: [contractId], references: [id])
  quote    Quote    @relation(fields: [quoteId], references: [id])
  taker    User     @relation("TakerTrades", fields: [takerId], references: [id])
  maker    User     @relation("MakerTrades", fields: [makerId], references: [id])

  @@unique([idempotencyKey, quoteId])
  @@index([contractId])
  @@index([takerId])
  @@index([makerId])
  @@index([status])
  @@index([contractId, status])
}

model Hint {
  id         Int      @id @default(autoincrement())
  contractId Int
  authorId   Int
  content    String   @db.Text
  linkUrl    String?
  linkLabel  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  contract Contract @relation(fields: [contractId], references: [id])
  author   User     @relation(fields: [authorId], references: [id])

  @@index([contractId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String   @db.Text
  // Optional in-app destination (e.g. "/players/12" for a DM). Clickable in the
  // notification panel; null = plain text notification.
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model NotificationArchive {
  id                Int      @id @default(autoincrement())
  originalId        Int      @unique
  userId            Int
  message           String   @db.Text
  isRead            Boolean
  originalCreatedAt DateTime
  archivedAt        DateTime @default(now())

  @@index([userId])
}

model BalanceLedger {
  id           Int       @id @default(autoincrement())
  userId       Int
  delta        Int
  balanceAfter Int
  eventType    EventType
  tradeId      Int?
  contractId   Int?
  initiatedBy  Int?
  note         String    @db.Text
  createdAt    DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([eventType])
  @@index([userId, createdAt])
}

model IdempotencyKey {
  id             Int      @id @default(autoincrement())
  actorId        Int
  action         String
  idempotencyKey String
  requestHash    String
  response       String   @db.Text
  createdAt      DateTime @default(now())

  @@unique([actorId, action, idempotencyKey])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @db.Text
  expiresAt DateTime
  usedAt    DateTime?
  createdBy Int
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Transactional outbox for outbound Discord delivery. A domain event (trade,
// settlement, new market, hint) appends a row POST-COMMIT; a drainer in
// server.js claims rows with `FOR UPDATE SKIP LOCKED` (multi-pod safe), POSTs an
// embed to the Discord channel webhook, then marks SENT / retries with backoff /
// gives up as DEAD. `dedupeKey` makes enqueue idempotent across accidental
// double-calls; `nextAttemptAt` doubles as a processing lease (a claim pushes it
// forward, so a crashed claim is reclaimable once the lease expires).
model DiscordOutbox {
  id               Int       @id @default(autoincrement())
  eventType        String
  channel          String    @default("feed") // "feed" = public channel webhook; "dm" = bot DM to targetDiscordId
  targetDiscordId  String?   // recipient's Discord snowflake when channel = "dm"
  payload          Json
  dedupeKey        String?   @unique
  status           String    @default("PENDING") // PENDING | PROCESSING | SENT | DEAD
  attempts         Int       @default(0)
  lastError        String?   @db.Text
  nextAttemptAt    DateTime  @default(now())
  discordMessageId String?
  createdAt        DateTime  @default(now())
  sentAt           DateTime?

  @@index([status, nextAttemptAt])
}

model AdminAuditLog {
  id           Int      @id @default(autoincrement())
  adminId      Int
  action       String
  targetType   String?
  targetId     Int?
  targetUserId Int?
  metadata     Json?
  ipAddress    String?
  note         String   @db.Text
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}
