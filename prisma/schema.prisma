// Prisma Schema — Trading Game Platform
// All 11 tables (TakeRequest dropped in phase-1 migration)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled URL at runtime (e.g. DO connection pool + ?pgbouncer=true)
  url       = env("TRADING_DATABASE_URL")
  // Direct Postgres for migrations / introspection (bypasses PgBouncer)
  directUrl = env("TRADING_DATABASE_DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  LIQUIDITY_PROVIDER
  USER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ContractStatus {
  OPEN
  SETTLED
}

enum QuoteStatus {
  OPEN
  EXHAUSTED
  CANCELLED
}

enum Side {
  OVER
  UNDER
}

enum TradeStatus {
  OPEN
  SETTLED
}

enum EventType {
  INITIAL_SEED
  SETTLEMENT
  ADMIN_ADJUSTMENT
}

// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique
  email          String     @unique
  hashedPassword String
  balance        Int        @default(0)
  role           Role       @default(USER)
  status         UserStatus @default(PENDING)
  approvedAt     DateTime?
  approvedBy     Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  quotes              Quote[]
  tradesAsTaker        Trade[]              @relation("TakerTrades")
  tradesAsMaker        Trade[]              @relation("MakerTrades")
  hints                Hint[]
  notifications        Notification[]
  balanceLedger        BalanceLedger[]
  passwordResetTokens  PasswordResetToken[]

  @@index([status])
}

model Contract {
  id              Int            @id @default(autoincrement())
  title           String
  description     String
  status          ContractStatus @default(OPEN)
  minPrice        Int            @default(0)
  maxPrice        Int            @default(100)
  settlementValue Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  quotes Quote[]
  trades Trade[]
  hints  Hint[]
}

model Quote {
  id         Int         @id @default(autoincrement())
  contractId Int
  makerId    Int
  bid        Int?
  ask        Int?
  size       Int
  status     QuoteStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relations
  contract Contract @relation(fields: [contractId], references: [id])
  maker    User     @relation(fields: [makerId], references: [id])
  trades   Trade[]

  @@index([contractId])
  @@index([makerId])
  @@index([contractId, status])
}

model Trade {
  id             Int         @id @default(autoincrement())
  contractId     Int
  quoteId        Int
  takerId        Int
  makerId        Int
  takerSide      Side
  strike         Int
  size           Int
  status         TradeStatus @default(OPEN)
  takerPnl       Int?
  makerPnl       Int?
  idempotencyKey String?
  createdAt      DateTime    @default(now())

  // Relations
  contract Contract @relation(fields: [contractId], references: [id])
  quote    Quote    @relation(fields: [quoteId], references: [id])
  taker    User     @relation("TakerTrades", fields: [takerId], references: [id])
  maker    User     @relation("MakerTrades", fields: [makerId], references: [id])

  @@unique([idempotencyKey, quoteId])
  @@index([contractId])
  @@index([takerId])
  @@index([makerId])
  @@index([status])
  @@index([contractId, status])
}

model Hint {
  id         Int      @id @default(autoincrement())
  contractId Int
  authorId   Int
  content    String   @db.Text
  linkUrl    String?
  linkLabel  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  contract Contract @relation(fields: [contractId], references: [id])
  author   User     @relation(fields: [authorId], references: [id])

  @@index([contractId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model NotificationArchive {
  id                Int      @id @default(autoincrement())
  originalId        Int      @unique
  userId            Int
  message           String   @db.Text
  isRead            Boolean
  originalCreatedAt DateTime
  archivedAt        DateTime @default(now())

  @@index([userId])
}

model BalanceLedger {
  id           Int       @id @default(autoincrement())
  userId       Int
  delta        Int
  balanceAfter Int
  eventType    EventType
  tradeId      Int?
  contractId   Int?
  initiatedBy  Int?
  note         String    @db.Text
  createdAt    DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([eventType])
  @@index([userId, createdAt])
}

model IdempotencyKey {
  id             Int      @id @default(autoincrement())
  actorId        Int
  action         String
  idempotencyKey String
  requestHash    String
  response       String   @db.Text
  createdAt      DateTime @default(now())

  @@unique([actorId, action, idempotencyKey])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @db.Text
  expiresAt DateTime
  usedAt    DateTime?
  createdBy Int
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AdminAuditLog {
  id           Int      @id @default(autoincrement())
  adminId      Int
  action       String
  targetType   String?
  targetId     Int?
  targetUserId Int?
  metadata     Json?
  ipAddress    String?
  note         String   @db.Text
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}
