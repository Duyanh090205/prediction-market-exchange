NODE_ENV=development
PORT=3000

# Shared Postgres cluster; isolate by schema/tables for trading app.
# Runtime queries (use pooled URL in prod, e.g. DO pool + pgbouncer=true).
TRADING_DATABASE_URL=postgresql://user:password@localhost:5432/trading_game_lab?schema=public
# Direct connection for Prisma migrate / db pull — never point through PgBouncer.
# Local dev: usually same as TRADING_DATABASE_URL (no pool).
TRADING_DATABASE_DIRECT_URL=postgresql://user:password@localhost:5432/trading_game_lab?schema=public

# NextAuth — trust Host header when behind a reverse proxy (DO App Platform, nginx, etc.)
AUTH_TRUST_HOST=true

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-random-32-byte-secret
AUTH_SECRET=replace-with-random-32-byte-secret

# Lab -> Trading handoff
TRADING_BASE_PATH=
NEXT_PUBLIC_TRADING_BASE_PATH=
NEXT_PUBLIC_LAB_API_URL=http://localhost:3000/api
LAB_SSO_SHARED_SECRET=replace-with-shared-secret
LAB_SSO_ISSUER=iterlight-lab-backend
LAB_SSO_AUDIENCE=trading-game-platform
LAB_LOGIN_URL=http://localhost:5173/login
NEXT_PUBLIC_LAB_LOGIN_URL=http://localhost:5173/login

# Optional runtime integrations
REDIS_URL=
RESET_TOKEN_SECRET=replace-with-random-32-byte-secret
CRON_SECRET=replace-with-random-32-byte-secret
